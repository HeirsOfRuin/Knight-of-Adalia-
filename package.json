{
  "name": "knight-of-adalia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "content": "tsx tools/build-content.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate.ts",
    "lint:style": "tsx tools/lint-style.ts",
    "bot": "tsx tools/bot.ts",
    "smoke": "tsx tools/smoke.ts",
    "transcript": "tsx tools/transcript.ts",
    "build:artifact": "npm run build && tsx tools/build-artifact.ts",
    "check": "npm run typecheck && npm test && npm run validate && npm run lint:style && npm run bot -- --runs 200"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
